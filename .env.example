# ResearchOps Agent configuration (copy to .env and edit)
# All variables use the RESEARCHOPS_ prefix.

# --- Runtime ---
RESEARCHOPS_EXECUTION_MODE=inline            # inline (api executes runs) | worker (separate worker process)
RESEARCHOPS_API_KEY=                         # unset = API open; set to require X-API-Key header
RESEARCHOPS_DATABASE_URL=sqlite+aiosqlite:///./.data/researchops.db
RESEARCHOPS_CHECKPOINT_DB=./.data/checkpoints.db
RESEARCHOPS_WORKSPACE_ROOT=./.data/workspaces

# --- LLM layer (OpenAI-compatible: OpenAI, DeepSeek, Together, vLLM, Ollama, ...) ---
RESEARCHOPS_LLM_PROVIDER=mock                # mock (offline, no key) | openai
RESEARCHOPS_LLM_BASE_URL=https://api.openai.com/v1
RESEARCHOPS_LLM_API_KEY=
RESEARCHOPS_LLM_MODEL=gpt-4o-mini
# Model routing: map task kind -> model. Falls back to LLM_MODEL for unmapped kinds.
# kinds: routing | extraction | planning | debugging | review | general
RESEARCHOPS_MODEL_ROUTES={"planning":"gpt-4o-mini","extraction":"gpt-4o-mini","review":"gpt-4o-mini"}

# --- Embeddings (semantic memory) ---
RESEARCHOPS_EMBEDDING_PROVIDER=hash          # hash (offline feature hashing) | openai
RESEARCHOPS_EMBEDDING_MODEL=text-embedding-3-small

# --- Budget / guardrails ---
RESEARCHOPS_MAX_COST_USD=5.0
RESEARCHOPS_MAX_MINUTES=30
RESEARCHOPS_MAX_TOOL_CALLS=200
RESEARCHOPS_APPROVAL_AUTO=false              # true = headless mode: MEDIUM/HIGH actions pre-approved
RESEARCHOPS_MAX_REPAIR_ATTEMPTS=2

# --- Sandbox ---
RESEARCHOPS_SANDBOX_BACKEND=local            # local (subprocess, dev) | docker
RESEARCHOPS_SANDBOX_IMAGE=python:3.11-slim
RESEARCHOPS_SANDBOX_TIMEOUT_S=120
RESEARCHOPS_SANDBOX_MEM_LIMIT_MB=1024
RESEARCHOPS_SANDBOX_CPUS=1.0

# --- Browser tool ---
RESEARCHOPS_BROWSER_ALLOW_DOMAINS=en.wikipedia.org,arxiv.org,github.com,huggingface.co
RESEARCHOPS_BROWSER_MAX_PAGES=10

# --- External keys (optional features) ---
GITHUB_TOKEN=                                # GitHub automation MCP server (PR creation etc.)
SEMANTIC_SCHOLAR_API_KEY=                    # citation graph; keyless works with low rate limits
